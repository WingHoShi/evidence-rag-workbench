# 可选：复制为 .env 在本机填写；也可启动后在网页“设置”中配置自己的 API。
# 请勿将真实 API Key 提交到 Git，网页保存的 runtime-config/ 同样不可分享。
EVIDENCE_RAG_ENV=development
EVIDENCE_RAG_DATA_DIR=data
# 默认限制：单文件 20 MiB，单知识库 100 MiB。
EVIDENCE_RAG_MAX_FILE_BYTES=20971520
EVIDENCE_RAG_MAX_KNOWLEDGE_BASE_BYTES=104857600

# 本地跨语言 Embedding；首次实际索引时从 ModelScope 下载，默认在 CPU 上运行。
EVIDENCE_RAG_EMBEDDING_MODEL=AI-ModelScope/multilingual-e5-small
EVIDENCE_RAG_EMBEDDING_MODEL_DIR=models/multilingual-e5-small
EVIDENCE_RAG_EMBEDDING_BATCH_SIZE=16

# 开发期默认使用本地嵌入式 Qdrant；部署时可改为 server 并设置 URL。
EVIDENCE_RAG_QDRANT_MODE=local
EVIDENCE_RAG_QDRANT_PATH=data/qdrant
# EVIDENCE_RAG_QDRANT_URL=http://127.0.0.1:6333

# 首版优先兼容 DeepSeek Chat Completions；API Key 不返回前端，地址和模型名可在设置页查看。
# 网页保存的完整配置优先于这里；保存后下一次问答生效。
EVIDENCE_RAG_LLM_BASE_URL=https://api.deepseek.com
EVIDENCE_RAG_LLM_API_KEY=
EVIDENCE_RAG_LLM_MODEL=deepseek-flash

# 网页模型配置（本机明文文件，不随仓库或镜像发布）
EVIDENCE_RAG_MODEL_CONFIG_PATH=runtime-config/model.json

# 混合检索中，纯向量候选至少达到此余弦相似度才可单独作为证据；BM25 命中不受此项限制。
EVIDENCE_RAG_RETRIEVAL_MIN_VECTOR_SCORE=0.55
